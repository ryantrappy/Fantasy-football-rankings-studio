# Public browser settings (embedded at build time)
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-spa-client-id
VITE_AUTH0_AUDIENCE=https://fantasy-rankings-api

# Server-only settings; never prefix secrets with VITE_
MONGODB_URI=mongodb://127.0.0.1:27017/fantasy_rankings
# Host path for MongoDB's persisted data when using Docker Compose.
MONGO_DATA_PATH=./.docker/mongo-data
AUTH0_ISSUER_BASE_URL=https://your-tenant.auth0.com/
AUTH0_AUDIENCE=https://fantasy-rankings-api
# Required to save/read per-user ESPN cookies. 32 random bytes encoded as 64 hex characters.
# Generate privately with: openssl rand -hex 32
ESPN_CREDENTIALS_KEY=

# Optional: enable /profile reads and edits with an Auth0 M2M app.
# Grant only read:users and update:users on the Auth0 Management API.
# Domain is the canonical tenant hostname (no https:// or trailing slash).
AUTH0_MANAGEMENT_DOMAIN=
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=

# Optional local CLI writing assistants. Empty disables generation.
# Comma-separated supported providers: codex,claude
WRITING_AI_PROVIDERS=
# Comma-separated Auth0 subjects allowed to use the server's CLI login.
WRITING_AI_USERS=
