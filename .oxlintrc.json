{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-hooks", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["node_modules", "dist", "build", "coverage"],
  "env": {
    "node": true,
    "browser": true
  }
}
