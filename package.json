    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^28.0.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "seroval": "^1.6.5",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.0.18"
