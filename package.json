{
  "name": "fantasy_power_rankings",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "PORT=${PORT:-3001} node --env-file-if-exists=.env --env-file-if-exists=.env.local .output/server/index.mjs",
    "build": "vite build && tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:espn-contract": "vitest run --config vitest.config.ts src/server/tests/espn-contract.integration.test.ts",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "dev": "vite dev --port 3001",
    "check:local": "npm run build && node scripts/check-local.mjs",
    "test:ui": "playwright test",
    "backup:verify": "vitest run --config vitest.backup.config.ts"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.28.2",
    "@chakra-ui/react": "^3.37.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@tanstack/ai": "^0.64.0",
    "@tanstack/charts": "^1.0.0",
    "@tanstack/db": "^0.11.3",
    "@tanstack/markdown": "^1.0.0",
    "@tanstack/query-core": "^5.104.1",
    "@tanstack/query-db-collection": "^1.3.4",
    "@tanstack/react-db": "^0.5.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-form-start": "^1.33.5",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-table": "^9.2.6",
    "axios": "^1.20.0",
    "dotenv": "^18.0.5",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.12",
    "mongoose": "^9.10.4",
    "nitro": "^3.0.260903-beta",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.2",
    "oxc-transform-react": "^0.145.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "seroval": "^1.6.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
